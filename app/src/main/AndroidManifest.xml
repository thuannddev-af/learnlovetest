<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lovetest">


        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ad_app_id}" />

        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:theme="@style/Theme.Lovetest.Ads"
            tools:replace="android:theme" />

        <activity android:name=".component.setting.SettingActivity"
            android:theme="@style/Theme.Lovetest.Main" android:exported="false" />
        <activity
            android:name=".component.lovetest.HoroscopeTestActivity"
            android:theme="@style/Theme.Lovetest.Main"
            android:exported="false" />
        <activity
            android:name=".component.lovetest.NameTestResultActivity"
            android:theme="@style/Theme.Lovetest.Main"
            android:exported="false" />
        <activity
            android:name=".component.lovetest.NameTestActivity"
            android:theme="@style/Theme.Lovetest.Main"
            android:exported="false" />
        <activity
            android:name=".component.main.memory.MemoryActivity"
            android:theme="@style/Theme.Lovetest.Main"
            android:exported="false" />
        <activity
            android:name=".component.startdate.StartDateActivity"
            android:theme="@style/Theme.Lovetest.Main"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.profile.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/profile_camera_paths" />
        </provider>
        <activity
            android:name=".component.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Lovetest.Main" />
        <activity
            android:name=".component.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Lovetest.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".component.language.LanguageActivity"
            android:theme="@style/Theme.Lovetest.Splash"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".component.onboarding.OnboardingActivity"
            android:theme="@style/Theme.Lovetest.Splash"
            android:exported="false" />
        <activity
            android:name=".component.permission.PermissionActivity"
            android:theme="@style/Theme.Lovetest.Splash"
            android:exported="false" />
    </application>

</manifest>
