<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Lovetest.Main" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">@font/plusjakartasans_regular</item>
        <item name="colorAccent">@color/splash_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Lovetest" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.Lovetest.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="ThemeOverlay.Lovetest.BackgroundSheet" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Lovetest.TransparentBottomSheet</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Widget.Lovetest.TransparentBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Lovetest.CircleAvatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <style name="AdsAppTheme" parent="Theme.AppCompat.Light" />

    <style name="AppTheme.Ads" parent="@style/AdsAppTheme">
        <item name="android:textSize">11.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:paddingLeft">3.0dip</item>
        <item name="android:paddingRight">6.0dip</item>
        <item name="android:paddingBottom">1.0dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">15.0px</item>
        <item name="android:minHeight">15.0px</item>
        <item name="android:text">Ad</item>
    </style>

</resources>
