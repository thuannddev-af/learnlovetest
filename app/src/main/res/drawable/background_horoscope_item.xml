<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape>
        <solid android:color="#FFF3F7" /><corners android:radius="8dp" />
        <stroke android:width="2dp" android:color="@color/splash_accent" />
    </shape></item>
    <item><shape>
        <solid android:color="@color/white" /><corners android:radius="8dp" />
        <stroke android:width="1dp" android:color="#FFC2D5" />
    </shape></item>
</selector>
