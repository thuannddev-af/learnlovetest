<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">
    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/plusjakartasans_semibold"
            android:gravity="center"
            android:text="@string/horoscope_test_title"
            android:textColor="@color/splash_title"
            android:textSize="20sp" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/start_date_back"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/splash_notice" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/btnYourSign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imgYourSign"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/background_home_avatar"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/love_aries" />
            <TextView
                android:id="@+id/tvYourSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:gravity="center"
                android:textColor="@color/splash_title"
                android:textSize="14sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="56dp"
            android:layout_height="104dp"
            android:layout_gravity="top"
            android:importantForAccessibility="no"
            android:src="@drawable/vinhcuu" />
        <LinearLayout
            android:id="@+id/btnPartnerSign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imgPartnerSign"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/background_home_avatar"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/love_aries" />
            <TextView
                android:id="@+id/tvPartnerSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:gravity="center"
                android:textColor="@color/splash_title"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/btnLoveTest"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/background_profile_save"
        android:clickable="true"
        android:enabled="false"
        android:focusable="true"
        android:fontFamily="@font/plusjakartasans_semibold"
        android:gravity="center"
        android:text="@string/love_test_title"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
