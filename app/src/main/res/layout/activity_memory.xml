<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">
    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/plusjakartasans_semibold"
            android:gravity="center"
            android:text="@string/home_memory_tab"
            android:textColor="@color/splash_title"
            android:textSize="20sp" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/start_date_back"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/splash_notice" />
    </FrameLayout>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <FrameLayout
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:background="@drawable/background_memory_photo"
                android:clickable="true"
                android:clipToOutline="true"
                android:contentDescription="@string/memory_add_photo"
                android:focusable="true">
                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/imgPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    app:round="16dp"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:id="@+id/tvPlus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/background_plus"
                    android:textColor="@color/white"
                    android:textSize="48sp" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:gravity="center"
                android:text="@string/memory_add_photo"
                android:textColor="@color/splash_notice"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:labelFor="@id/edtTitle"
                android:text="@string/memory_title"
                android:textColor="@color/splash_notice"
                android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_profile_field"
                android:fontFamily="@font/plusjakartasans_regular"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/splash_title"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/btnDate"
                android:text="@string/memory_date"
                android:textColor="@color/splash_notice"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/btnDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_profile_field"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar"
                android:focusable="true"
                android:fontFamily="@font/plusjakartasans_regular"
                android:gravity="center_vertical"
                android:hint="@string/memory_date_hint"
                android:paddingHorizontal="12dp"
                android:textColor="@color/splash_notice"
                android:textColorHint="@color/splash_notice"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/background_profile_save"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/plusjakartasans_semibold"
        android:gravity="center"
        android:text="@string/profile_save"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
