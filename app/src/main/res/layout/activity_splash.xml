<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    tools:context=".component.splash.SplashActivity">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/logoTopGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.24" />
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="@dimen/size136"
        android:layout_height="@dimen/size136"
        android:importantForAccessibility="no"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="@id/logoTopGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/pacifico_regular"
        android:includeFontPadding="false"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#40000000"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:text="@string/splash"
        android:textColor="@color/splash_title"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/splashLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/splashDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/adNotice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_selector" />
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/dot_selector" />
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/dot_selector" />
        <View
            android:id="@+id/selectedDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/dot_selector" />
    </LinearLayout>
    <TextView
        android:id="@+id/adNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:fontFamily="@font/plusjakartasans_regular"
        android:gravity="center"
        android:text="@string/splash_ad_notice"
        android:textColor="@color/splash_notice"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
